<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Жалоба в ФССП</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 14pt;
            line-height: 1.5;
            margin: 2cm;
        }
        .header {
            text-align: center;
            margin-bottom: 1cm;
        }
        .section {
            margin-bottom: 0.5cm;
        }
        .signature {
            margin-top: 1cm;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>В <%= data.recipient %></h2>
        <h3><%= data.recipientPosition %></h3>
        <p><%= data.recipientAddress %></p>
    </div>

    <div class="section">
        <p>От: <%= data.applicantFullName %></p>
        <p>Адрес: <%= data.applicantAddress %></p>
        <p>Телефон: <%= data.applicantPhone %></p>
        <p>Email: <%= data.applicantEmail %></p>
    </div>

    <div class="section">
        <h3>Заявление</h3>
        <p><%= data.documentSummary %></p>
    </div>

    <% if (data.executiveProductionNumber) { %>
    <div class="section">
        <p>Исполнительное производство № <%= data.executiveProductionNumber %></p>
    </div>
    <% } %>

    <% if (data.violations && data.violations.length > 0) { %>
    <div class="section">
        <h4>Выявленные нарушения:</h4>
        <ul>
            <% data.violations.forEach(function(violation) { %>
            <li><%= violation %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <% if (data.legalReferences && data.legalReferences.length > 0) { %>
    <div class="section">
        <h4>Ссылки на законодательство:</h4>
        <ul>
            <% data.legalReferences.forEach(function(reference) { %>
            <li><%= reference %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <% if (data.requirements && data.requirements.length > 0) { %>
    <div class="section">
        <h4>Прошу:</h4>
        <ul>
            <% data.requirements.forEach(function(requirement) { %>
            <li><%= requirement %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <% if (data.attachments && data.attachments.length > 0) { %>
    <div class="section">
        <h4>Приложения:</h4>
        <ul>
            <% data.attachments.forEach(function(attachment, index) { %>
            <li><%= index + 1 %>. <%= attachment.summary %> от <%= attachment.date %></li>
            <% }); %>
        </ul>
    </div>
    <% } %>

    <div class="signature">
        <p><%= data.complaintDate %></p>
        <p>___________________ /<%= data.applicantFullName %>/</p>
    </div>
</body>
</html>