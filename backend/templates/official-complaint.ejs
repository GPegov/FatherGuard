<%
  // Default values for all variables to prevent undefined errors
  const currentDate = new Date().toLocaleDateString('ru-RU');
  const complaintDate = data.complaintDate || currentDate;
  const recipient = data.recipient || 'Федеральная служба судебных приставов';
  const recipientAddress = data.recipientAddress || '127994, г. Москва, ул. Щепкина, д. 8';
  const applicantFullName = data.applicantFullName || '';
  const applicantAddress = data.applicantAddress || '';
  const applicantPhone = data.applicantPhone || '';
  const applicantEmail = data.applicantEmail || '';
  const documentDate = data.documentDate || '';
  const documentNumber = data.documentNumber || '';
  const documentAgency = data.documentAgency || '';
  const documentSummary = data.documentSummary || '';
  const violations = Array.isArray(data.violations) ? data.violations : [];
  const legalReferences = Array.isArray(data.legalReferences) ? data.legalReferences : [];
  const requirements = Array.isArray(data.requirements) ? data.requirements : [];
  const attachments = Array.isArray(data.attachments) ? data.attachments : [];
  const complaintNumber = data.complaintNumber || 'Б/Н';
%>
<%
  // Helper function to format dates
  function formatDate(dateStr) {
    if (!dateStr) return '';
    const date = new Date(dateStr);
    return isNaN(date) ? dateStr : date.toLocaleDateString('ru-RU');
  }
%>

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Жалоба в <%= recipient %></title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 14pt;
            line-height: 1.5;
            margin: 2cm;
        }
        .header {
            text-align: center;
            margin-bottom: 1cm;
        }
        .recipient {
            text-align: left;
            margin-bottom: 1cm;
        }
        .title {
            text-align: center;
            font-weight: bold;
            margin: 1cm 0;
            text-decoration: underline;
        }
        .content {
            text-align: justify;
            margin-bottom: 1cm;
        }
        .requirements {
            margin: 1cm 0;
        }
        .attachments {
            margin: 1cm 0;
        }
        .signature {
            margin-top: 1cm;
            text-align: right;
        }
        .page-break {
            page-break-after: always;
        }
        h1, h2, h3 {
            font-weight: bold;
        }
        ul, ol {
            margin: 0.5cm 0;
            padding-left: 1cm;
        }
    </style>
</head>
<body>
    <div class="header">
        <p><%= applicantFullName %><br>
        <%= applicantAddress %><br>
        Тел.: <%= applicantPhone %><br>
        Email: <%= applicantEmail %></p>
    </div>

    <div class="recipient">
        <p>В <%= recipient %><br>
        <%= recipientAddress %></p>
    </div>

    <div class="title">
        <h1>ДОЛЖНОСТНОМУ ЛИЦУ</h1>
    </div>

    <div class="content">
        <p>Я, нижеподписавшийся(аяся) <%= applicantFullName %>, проживающий(ая) по адресу: <%= applicantAddress %>, 
        в <%= complaintDate %> года получил(а) документ от <%= documentAgency %> № <%= documentNumber %> от <%= formatDate(documentDate) %>, 
        суть которого: <%= documentSummary %>.</p>

        <% if (violations && violations.length > 0) { %>
        <p>Указанный документ содержит нарушения следующих норм законодательства:</p>
        <ul>
            <% violations.forEach(function(violation) { %>
            <li><%= violation %></li>
            <% }); %>
        </ul>
        <% } %>

        <% if (legalReferences && legalReferences.length > 0) { %>
        <p>Нарушения основаны на следующих нормах законодательства:</p>
        <ul>
            <% legalReferences.forEach(function(ref) { %>
            <li><%= ref %></li>
            <% }); %>
        </ul>
        <% } %>
    </div>

    <div class="requirements">
        <p>На основании вышеизложенного, руководствуясь статьями 3, 12, 18 Федерального закона от 02.05.2006 № 59-ФЗ 
        «О порядке рассмотрения обращений граждан Российской Федерации», прошу:</p>
        <ol>
            <% if (requirements && requirements.length > 0) { %>
            <% requirements.forEach(function(req) { %>
            <li><%= req %></li>
            <% }); %>
            <% } else { %>
            <li>Провести проверку по обстоятельствам изложенного в настоящей жалобе.</li>
            <li>Принять меры по устранению выявленных нарушений.</li>
            <li>Предоставить письменный ответ с указанием принятых мер в течение 30 дней со дня регистрации настоящей жалобы.</li>
            <% } %>
        </ol>
    </div>

    <% if (attachments && attachments.length > 0) { %>
    <div class="attachments">
        <p>Приложения:</p>
        <ol>
            <% attachments.forEach(function(attachment, index) { %>
            <li><%= attachment %></li>
            <% }); %>
        </ol>
    </div>
    <% } %>

    <div class="signature">
        <p>Дата: <%= complaintDate %> г.</p>
        <p>Подпись: _________________ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <%= applicantFullName %></p>
    </div>

    <% if (attachments && attachments.length > 0) { %>
    <div class="page-break"></div>
    <h2>Приложения к жалобе № <%= complaintNumber %> от <%= complaintDate %> г.</h2>
    
    <% attachments.forEach(function(attachment, index) { %>
    <div>
        <h3>Приложение № <%= index + 1 %></h3>
        <p><%= attachment %></p>
    </div>
    <% }); %>
    <% } %>
</body>
</html>